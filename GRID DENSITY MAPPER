# ========================= ENHANCED CNN GRID MODEL =========================
class CNNGridDensityMapper:
    def __init__(self, grid_rows=6, grid_cols=6, low_density_threshold=1.5):
        self.model = YOLO('yolov8x.pt')
        self.grid_rows = grid_rows
        self.grid_cols = grid_cols
        self.low_density_threshold = low_density_threshold
        self.person_tracks = defaultdict(list)
        self.max_age = 120
        self.max_dist = 100

    def split_into_detection_tiles(self, frame, rows=2, cols=2):
        """Enhanced tile detection"""
        h, w = frame.shape[:2]
        tiles = []
        tile_h, tile_w = h // rows, w // cols
        for r in range(rows):
            for c in range(cols):
                y1, y2 = r * tile_h, min((r + 1) * tile_h, h)
                x1, x2 = c * tile_w, min((c + 1) * tile_w, w)
                tiles.append((frame[y1:y2, x1:x2], r, c, x1, y1, x2-x1, y2-y1))
        return tiles

    def continuous_person_detection(self, frame):
        """Industrial-grade person detection"""
        tiles = self.split_into_detection_tiles(frame)
        all_detections = []

        for tile_img, tile_r, tile_c, tx1, ty1, tw, th in tiles:
            results = self.model(tile_img, conf=0.18, iou=0.5, classes=[0],
                               imgsz=1280, verbose=False)

            for box in results[0].boxes:
                x1, y1, x2, y2 = box.xyxy[0].cpu().numpy()
                conf = box.conf[0].cpu().numpy()

                # Enhanced human filtering
                w, h = x2-x1, y2-y1
                area = w * h
                aspect = w / max(h, 1e-6)

                if 1000 <= area <= 40000 and 0.2 <= aspect <= 1.2:
                    # Global coordinates
                    gx1 = tile_c * tw + x1 + tx1
                    gy1 = tile_r * th + y1 + ty1
                    gx2 = tile_c * tw + x2 + tx1
                    gy2 = tile_r * th + y2 + ty1

                    cx, cy = (gx1 + gx2)/2, (gy1 + gy2)/2
                    all_detections.append({
                        'bbox': [gx1, gy1, gx2, gy2],
                        'centroid': (cx, cy),
                        'conf': conf
                    })

        return all_detections

    def update_tracks(self, detections, frame_id):
        """Never-lose tracking"""
        current_centroids = np.array([d['centroid'] for d in detections])

        # Match tracks
        for pid, track in list(self.person_tracks.items()):
            if len(track) >= self.max_age:
                del self.person_tracks[pid]
                continue

            if len(track) > 0:
                prev_cx, prev_cy = track[-1]['centroid']
                if len(current_centroids) > 0:
                    distances = np.linalg.norm(current_centroids - np.array([prev_cx, prev_cy]), axis=1)
                    closest_idx = np.argmin(distances)
                    if distances[closest_idx] < self.max_dist:
                        det = detections[closest_idx]
                        track.append({
                            'frame': frame_id,
                            'centroid': det['centroid'],
                            'bbox': det['bbox'],
                            'conf': det['conf'],
                            'detected': True
                        })
                        continue

        # New detections
        next_id = max(self.person_tracks.keys(), default=0) + 1
        used_indices = set()
        for i, det in enumerate(detections):
            if i not in used_indices:
                self.person_tracks[next_id].append({
                    'frame': frame_id,
                    'centroid': det['centroid'],
                    'bbox': det['bbox'],
                    'conf': det['conf'],
                    'detected': True
                })
                next_id += 1

        return len(self.person_tracks)

    def compute_cnn_grid_density(self, frame_shape, frame_id):
        """Enhanced grid analysis"""
        h, w = frame_shape[:2]
        cell_h, cell_w = h // self.grid_rows, w // self.grid_cols

        density_grid = np.zeros((self.grid_rows, self.grid_cols))
        low_density_cells = []
        high_density_cells = []
        medium_density_cells = []

        # Count per cell
        for pid, track in self.person_tracks.items():
            if len(track) == 0 or track[-1]['frame'] != frame_id:
                continue
            cx, cy = track[-1]['centroid']

            row = min(int(cy // cell_h), self.grid_rows - 1)
            col = min(int(cx // cell_w), self.grid_cols - 1)
            density_grid[row, col] += 1

        # Classify cells
        for r in range(self.grid_rows):
            for c in range(self.grid_cols):
                density = density_grid[r, c]
                cell_bbox = [c * cell_w, r * cell_h, (c+1) * cell_w, (r+1) * cell_h]

                if density <= self.low_density_threshold:
                    low_density_cells.append({'row': r, 'col': c, 'density': density, 'bbox': cell_bbox})
                elif density <= self.low_density_threshold * 2.5:
                    medium_density_cells.append({'row': r, 'col': c, 'density': density, 'bbox': cell_bbox})
                else:
                    high_density_cells.append({'row': r, 'col': c, 'density': density, 'bbox': cell_bbox})

        return density_grid, low_density_cells, medium_density_cells, high_density_cells

    def visualize_perfect_density(self, frame, density_grid, low_cells, med_cells, high_cells):
        """🎨 PERFECT COLORS: Green/Yellow/Red + Borders"""
        vis_frame = frame.copy()
        h, w = frame.shape[:2]
        cell_h, cell_w = h // self.grid_rows, w // self.grid_cols

        # 🟢🟡🔴 COLORED REGIONS (light overlay)
        alpha = 0.4  # Light transparency

        # 🔴 RED - High density
        for cell in high_cells:
            x1, y1, x2, y2 = map(int, cell['bbox'])
            overlay = vis_frame.copy()
            overlay[:] = (0, 0, 255)  # Red
            cv2.addWeighted(overlay, alpha, vis_frame, 1-alpha, 0, vis_frame[y1:y2, x1:x2])
            cv2.rectangle(vis_frame, (x1, y1), (x2, y2), (0, 0, 200), 3)

        # 🟡 YELLOW - Medium density
        for cell in med_cells:
            x1, y1, x2, y2 = map(int, cell['bbox'])
            overlay = vis_frame.copy()
            overlay[:] = (0, 255, 255)  # Yellow
            cv2.addWeighted(overlay, alpha, vis_frame, 1-alpha, 0, vis_frame[y1:y2, x1:x2])
            cv2.rectangle(vis_frame, (x1, y1), (x2, y2), (0, 200, 0), 2)

        # 🟢 GREEN - Low density (lightest + thick border)
        for cell in low_cells:
            x1, y1, x2, y2 = map(int, cell['bbox'])
            overlay = vis_frame.copy()
            overlay[:] = (0, 255, 0)  # Green
            cv2.addWeighted(overlay, alpha * 0.7, vis_frame, 1-alpha*0.7, 0, vis_frame[y1:y2, x1:x2])
            cv2.rectangle(vis_frame, (x1, y1), (x2, y2), (0, 255, 0), 5)  # Thick green border
            cv2.putText(vis_frame, f"SAFE {cell['density']:.0f}",
                       (x1+10, y1+35), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 3)

        # Grid lines
        for r in range(self.grid_rows + 1):
            cv2.line(vis_frame, (0, r * cell_h), (w, r * cell_h), (128, 128, 128), 1)
        for c in range(self.grid_cols + 1):
            cv2.line(vis_frame, (c * cell_w, 0), (c * cell_w, h), (128, 128, 128), 1)

        # Legend
        legend_y = 20
        cv2.rectangle(vis_frame, (10, 10), (300, legend_y*5+20), (0, 0, 0), -1)

        cv2.rectangle(vis_frame, (20, legend_y), (60, legend_y+20), (0, 255, 0), -1)
        cv2.putText(vis_frame, "SAFE (Low)", (70, legend_y+15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 1)

        cv2.rectangle(vis_frame, (20, legend_y*2), (60, legend_y*2+20), (0, 255, 255), -1)
        cv2.putText(vis_frame, "MEDIUM", (70, legend_y*2+15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)

        cv2.rectangle(vis_frame, (20, legend_y*3), (60, legend_y*3+20), (0, 0, 255), -1)
        cv2.putText(vis_frame, "DANGER (High)", (70, legend_y*3+15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)

        cv2.putText(vis_frame, f"Grid: {self.grid_rows}x{self.grid_cols}", (20, legend_y*4+15),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

        return vis_frame

    def process_video(self, video_path, sample_frames=50):
        """Enhanced video processing"""
        cap = cv2.VideoCapture(video_path)
        if not cap.isOpened():
            return None, None, None

        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        fps = cap.get(cv2.CAP_PROP_FPS) or 30

        frame_indices = np.linspace(0, total_frames-1, sample_frames, dtype=int)
        results = []
        sample_frames_list = []

        print(f"🎬 Processing {total_frames} frames...")

        for i, frame_id in enumerate(frame_indices):
            cap.set(cv2.CAP_PROP_POS_FRAMES, frame_id)
            ret, frame = cap.read()
            if not ret:
                continue

            # Continuous detection + tracking
            detections = self.continuous_person_detection(frame)
            active_tracks = self.update_tracks(detections, frame_id)

            # Grid analysis
            density_grid, low_cells, med_cells, high_cells = self.compute_cnn_grid_density(frame.shape, frame_id)

            # PERFECT visualization
            vis_frame = self.visualize_perfect_density(frame, density_grid, low_cells, med_cells, high_cells)

            # Stats
            total_density = density_grid.sum()
            safe_count = len(low_cells)
            crowded_count = len(high_cells)

            results.append({
                'frame_id': frame_id,
                'time_sec': round(frame_id / fps, 1),
                'people': active_tracks,
                'safe_zones': safe_count,
                'crowded_zones': crowded_count,
                'total_density': round(total_density, 1)
            })

            sample_frames_list.append(vis_frame)

            if i % 10 == 0:
                print(f"Frame {frame_id}: {active_tracks}p | {safe_count}🟢 | {crowded_count}🔴")

        cap.release()
        df = pd.DataFrame(results)
        return df, sample_frames_list, density_grid

# ========================= ENHANCED GRADIO =========================
def analyze_perfect_density(video_path, grid_size=6, density_threshold=1.5, sample_frames=30):
    if video_path is None:
        return "No video", None, None, None, None, None

    mapper = CNNGridDensityMapper(grid_rows=grid_size, grid_cols=grid_size,
                                low_density_threshold=density_threshold)

    df, sample_frames, final_grid = mapper.process_video(video_path, sample_frames)

    if df is None:
        return "Processing failed", None, None, None, None, None

    # PERFECT summary
    summary = f"""
🗺️ **PERFECT GRID DENSITY ANALYSIS**

🎯 **SUMMARY:**
• Samples: {len(df)} frames analyzed
• Avg People: {df['people'].mean():.1f}
• 🟢 Safe Zones: {df['safe_zones'].mean():.1f} avg/frame
• 🔴 Crowded: {df['crowded_zones'].max()} max detected

🏆 **BEST FRAMES (Most Safe):**
{df.nlargest(5, 'safe_zones')[['time_sec', 'safe_zones', 'people']].round(1).to_string(index=False)}

🎨 **COLOR CODING:**
🟢 **GREEN** (light) = Safe ≤{density_threshold}p/cell ✓
🟡 **YELLOW** (light) = Medium {density_threshold}-{density_threshold*2.5}p/cell ⚠️
🔴 **RED** (light) = Danger >{density_threshold*2.5}p/cell ✗
"""

    # Charts
    fig1 = px.line(df, x='time_sec', y=['people', 'safe_zones'],
                  title="🧑 People vs 🟢 Safe Zones Over Time")

    fig2 = px.imshow(final_grid, title="Final Density Heatmap",
                    color_continuous_scale='RdYlGn_r')

    fig3 = px.scatter(df, x='people', y='safe_zones', size='crowded_zones',
                     title="Safe vs Crowded Analysis")

    # Gallery (PIL Images)
    gallery = []
    for frame in sample_frames[:12]:
        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        gallery.append(Image.fromarray(frame_rgb))

    return summary, fig1, fig2, fig3, gallery, df

