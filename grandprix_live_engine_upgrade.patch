@@ -0,0 +1,169 @@
+:root{
+  --bg-asphalt:#0B0D0F;
+  --bg-panel:#14181C;
+  --bg-panel-raised:#1A2025;
+  --line:#262B30;
+  --text-primary:#E8ECEF;
+  --text-dim:#7C868D;
+
+  --flag-green:#17C964;
+  --flag-yellow:#F5C518;
+  --flag-orange:#FF8A1E;
+  --flag-red:#FF3B30;
+  --signal-cyan:#00D4FF;
+
+  --font-display: -apple-system, "Segoe UI", "Arial Narrow", system-ui, sans-serif;
+  --font-mono: ui-monospace, "SF Mono", "Cascadia Mono", "Consolas", "Roboto Mono", monospace;
+}
+
+*{box-sizing:border-box;}
+html,body{margin:0;padding:0;height:100%;}
+body{
+  background:
+    radial-gradient(1200px 600px at 15% -10%, #171c20 0%, transparent 60%),
+    var(--bg-asphalt);
+  color:var(--text-primary);
+  font-family:var(--font-display);
+  min-height:100vh;
+  display:flex;
+  flex-direction:column;
+}
+
+/* ---------- top bar ---------- */
+.topbar{
+  display:flex;
+  align-items:center;
+  justify-content:space-between;
+  gap:24px;
+  padding:14px 24px;
+  border-bottom:1px solid var(--line);
+  background:linear-gradient(180deg,#12161A 0%, #0F1215 100%);
+}
+.brand{display:flex;align-items:center;gap:12px;}
+.brand-mark{
+  width:14px;height:14px;border-radius:3px;
+  background:linear-gradient(135deg,var(--flag-green),var(--signal-cyan));
+  box-shadow:0 0 12px rgba(0,212,255,.5);
+  flex-shrink:0;
+}
+.brand-title{font-weight:800;letter-spacing:.06em;font-size:15px;}
+.brand-sub{font-size:11px;color:var(--text-dim);letter-spacing:.03em;margin-top:2px;}
+
+.session-status{display:flex;align-items:center;gap:18px;}
+.status-chip{
+  font-family:var(--font-mono);
+  font-size:12px;font-weight:700;letter-spacing:.08em;
+  padding:6px 12px;border-radius:4px;
+  background:var(--bg-panel-raised);
+  border:1px solid var(--line);
+  color:var(--flag-yellow);
+  text-transform:uppercase;
+}
+.clock{font-family:var(--font-mono);display:flex;align-items:baseline;gap:6px;}
+.clock-label{font-size:10px;color:var(--text-dim);letter-spacing:.08em;}
+.clock-value{font-size:18px;font-weight:700;color:var(--signal-cyan);}
+
+.btn-ghost{
+  font-family:var(--font-mono);
+  background:transparent;color:var(--text-dim);
+  border:1px solid var(--line);border-radius:4px;
+  padding:8px 14px;font-size:11px;letter-spacing:.06em;cursor:pointer;
+  transition:all .15s ease;
+}
+.btn-ghost:hover{border-color:var(--signal-cyan);color:var(--signal-cyan);}
+
+/* ---------- layout ---------- */
+.layout{
+  flex:1;
+  display:grid;
+  grid-template-columns:1fr 340px;
+  grid-template-rows:1fr auto;
+  gap:14px;
+  padding:16px 24px 24px;
+}
+.panel{
+  background:var(--bg-panel);
+  border:1px solid var(--line);
+  border-radius:6px;
+  display:flex;flex-direction:column;
+  overflow:hidden;
+}
+.panel-head{
+  display:flex;align-items:center;justify-content:space-between;
+  padding:10px 14px;border-bottom:1px solid var(--line);
+  background:var(--bg-panel-raised);
+}
+.panel-title{font-size:11px;font-weight:700;letter-spacing:.09em;color:var(--text-dim);}
+.panel-hint{font-size:10px;color:var(--text-dim);font-family:var(--font-mono);}
+.badge{
+  font-family:var(--font-mono);font-size:11px;font-weight:700;
+  background:var(--bg-asphalt);border:1px solid var(--line);
+  border-radius:10px;padding:1px 8px;color:var(--text-dim);
+}
+
+.map-panel{grid-column:1;grid-row:1;}
+#venue-canvas{flex:1;width:100%;display:block;}
+.legend{
+  display:flex;flex-wrap:wrap;gap:14px;
+  padding:8px 14px;border-top:1px solid var(--line);
+  font-size:10px;color:var(--text-dim);letter-spacing:.02em;
+}
+.legend-item{display:flex;align-items:center;gap:5px;}
+.legend-sep{margin-left:auto;}
+.dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
+.dot-comfortable{background:var(--flag-green);}
+.dot-busy{background:#9FE870;}
+.dot-congested{background:var(--flag-orange);}
+.dot-at_risk{background:var(--flag-red);}
+.dot-crush_risk{background:var(--flag-red);box-shadow:0 0 6px var(--flag-red);}
+.dot-reroute{background:var(--signal-cyan);box-shadow:0 0 6px var(--signal-cyan);}
+
+.side-panels{grid-column:2;grid-row:1;display:flex;flex-direction:column;gap:14px;min-height:0;}
+.alerts-panel,.reroute-panel{flex:1;min-height:0;}
+.panel-body{flex:1;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:8px;}
+
+.empty-state{
+  color:var(--text-dim);font-size:12px;font-family:var(--font-mono);
+  padding:16px 8px;text-align:center;
+}
+
+.alert-card{
+  border:1px solid var(--line);border-left:3px solid var(--flag-red);
+  border-radius:4px;padding:8px 10px;background:var(--bg-panel-raised);
+}
+.alert-card.sev-mid{border-left-color:var(--flag-orange);}
+.alert-card .a-zone{font-weight:700;font-size:12.5px;}
+.alert-card .a-meta{
+  font-family:var(--font-mono);font-size:10.5px;color:var(--text-dim);
+  margin-top:4px;display:flex;justify-content:space-between;
+}
+.alert-card .a-sev{color:var(--flag-red);font-weight:700;}
+
+.reroute-card{
+  border:1px solid var(--line);border-left:3px solid var(--signal-cyan);
+  border-radius:4px;padding:8px 10px;background:var(--bg-panel-raised);
+  font-size:11.5px;line-height:1.5;
+}
+.reroute-card .r-path{font-family:var(--font-mono);color:var(--signal-cyan);font-size:11px;margin-top:4px;}
+
+.footer-panel{
+  grid-column:1 / span 2;grid-row:2;
+  flex-direction:row;align-items:center;gap:20px;padding:12px 18px;
+}
+.occ-block{min-width:170px;}
+.occ-label{font-size:10px;color:var(--text-dim);letter-spacing:.08em;}
+.occ-value{font-family:var(--font-mono);font-size:20px;font-weight:700;margin-top:2px;}
+.occ-max{color:var(--text-dim);font-size:14px;font-weight:500;}
+#spark-canvas{flex:1;height:44px;}
+.model-note{
+  font-family:var(--font-mono);font-size:10px;color:var(--text-dim);
+  max-width:340px;line-height:1.5;flex-shrink:0;
+}
+.model-note code{color:var(--signal-cyan);}
+
+@media (max-width: 900px){
+  .layout{grid-template-columns:1fr;}
+  .map-panel{grid-column:1;grid-row:1;}
+  .side-panels{grid-column:1;grid-row:2;flex-direction:row;}
+  .footer-panel{grid-column:1;grid-row:3;flex-wrap:wrap;}
+}
